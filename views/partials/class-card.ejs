<link rel="stylesheet" href="styles/class-card.css">

<% const _gradeNum = Number(classItem.grade); const wheelPct = Math.min(100, Math.max(0, Number.isFinite(_gradeNum) ? _gradeNum : 0));
   let _pctWheelDash;
   if (wheelPct >= 100) _pctWheelDash = 100;
   else if (wheelPct <= 0) _pctWheelDash = 0;
   else if (wheelPct >= 98) _pctWheelDash = wheelPct - 3;
   else if (wheelPct >= 94) _pctWheelDash = wheelPct - 2;
   else if (wheelPct > 90) _pctWheelDash = wheelPct - 1;
   else _pctWheelDash = wheelPct;
%>

<li class="class-card">
    <div class="pct-wheel square center-content fill-space" role="img" aria-label="Class grade <%= Math.round(wheelPct) %> percent">
        <svg class="pct-wheel-svg" viewBox="0 0 36 36" aria-hidden="true">
            <!-- Circumference tuned to 100 so stroke-dasharray matches grade 0–100 -->
            <path class="pct-wheel-track" fill="none" stroke-width="3"
                d="M18 2.0845 a 15.9155 15.9155 0 0 1 0 31.831 a 15.9155 15.9155 0 0 1 0 -31.831" />
            <% if (wheelPct > 0) { %>
            <path class="pct-wheel-fill" fill="none" stroke-width="3"
                stroke-dasharray="<%= _pctWheelDash %>, 100"
                d="M18 2.0845 a 15.9155 15.9155 0 0 1 0 31.831 a 15.9155 15.9155 0 0 1 0 -31.831" />
            <% } %>
        </svg>
        <span class="pct-wheel-value"><%= Math.round(wheelPct) %><span class="pct-wheel-suffix">%</span></span>
    </div>
    <div class="class-card-text spacer">
        <span class="class-card-text1 elipsis-text"><%= classItem.title %></span>
        <span class="class-card-text2 elipsis-text"><%= classItem.code %></span>
        <% const _dateFmt = new Intl.DateTimeFormat('en-US', { month: 'short', day: 'numeric', year: 'numeric' });
           const _start = classItem.startDate instanceof Date ? classItem.startDate : new Date(classItem.startDate);
           const _end = classItem.endDate instanceof Date ? classItem.endDate : new Date(classItem.endDate);
           const _startOk = !Number.isNaN(_start.getTime());
           const _endOk = !Number.isNaN(_end.getTime());
           let _dateText = '';
           if (_startOk && _endOk) {
               _dateText = _dateFmt.format(_start) + ' – ' + _dateFmt.format(_end);
           } else if (_startOk) {
               _dateText = _dateFmt.format(_start);
           } else if (_endOk) {
               _dateText = _dateFmt.format(_end);
           }
        %>
        <% if (_dateText) { %>
        <span class="class-card-dates"><%= _dateText %></span>
        <% } %>
    </div>
    <ul id="deliverables-div">
        <% const taskGroups = Array.isArray(classItem.taskGroups) ? classItem.taskGroups : []; %>
        <% const uniqueTasks = Array.isArray(classItem.uniqueTasks) ? classItem.uniqueTasks : []; %>
        <% const deliverables = [
            ...taskGroups.map(function (g) { return { item: g }; }),
            ...uniqueTasks.map(function (t) { return { item: t }; })
        ]; %>
        <% deliverables.sort(function (a, b) {
            const wa = Number(a.item && a.item.weight);
            const wb = Number(b.item && b.item.weight);
            return (Number.isFinite(wb) ? wb : 0) - (Number.isFinite(wa) ? wa : 0);
        }); %>
        <% deliverables.slice(0,3).forEach(function (d) { %>
            <%- include("./deliverables.ejs", d) %>
        <% }) %>
        <% if (deliverables.length > 3) { %>
            <li>
                <div id="deliverableOverflow" class="super-subtle-text">
                    <span>... +<%= (deliverables.length - 3) %> More </span>
                </div>
            </li>
        <% } %>
    </ul>
    <button type="button" class="options-btn circle clickable-btn center-content">
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" viewBox="0 0 16 16">
            <path d="M9.5 13a1.5 1.5 0 1 1-3 0 1.5 1.5 0 0 1 3 0m0-5a1.5 1.5 0 1 1-3 0 1.5 1.5 0 0 1 3 0m0-5a1.5 1.5 0 1 1-3 0 1.5 1.5 0 0 1 3 0"/>
          </svg>          
    </button>
</li>