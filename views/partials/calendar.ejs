<%
  const cardEndpoint = typeof endpoint === 'string' ? endpoint : '';
  const cardPageUrl = typeof pageUrl === 'string' ? pageUrl : '';
  const cardAriaLabel = typeof ariaLabel === 'string' ? ariaLabel : 'Academic calendar';
  const prevQuery = '?year=' + calendar.prev.year + '&month=' + calendar.prev.month;
  const nextQuery = '?year=' + calendar.next.year + '&month=' + calendar.next.month;
  const prevHref = cardPageUrl ? cardPageUrl + prevQuery : prevQuery;
  const nextHref = cardPageUrl ? cardPageUrl + nextQuery : nextQuery;
%>
<section class="calendar-card"
         aria-label="<%= cardAriaLabel %>"
         <% if (cardEndpoint) { %>data-endpoint="<%= cardEndpoint %>"<% } %>
         <% if (cardPageUrl) { %>data-page-url="<%= cardPageUrl %>"<% } %>>
    <div class="calendar-header">
        <div class="calendar-header-titles">
            <h2>Calendar</h2>
            <p class="calendar-month" id="calendar-month-label" aria-live="polite"><%= calendar.label %></p>
        </div>
        <div class="calendar-nav-controls">
            <button type="button"
                    class="calendar-today-btn"
                    id="calendar-today-btn"
                    aria-label="Jump to current month"
                    data-year="<%= calendar.today.year %>"
                    data-month="<%= calendar.today.month %>"
                    <%= calendar.isCurrentMonth ? 'hidden' : '' %>>
                Today
            </button>
            <div class="calendar-nav-arrows">
                <a href="<%= prevHref %>"
                   class="calendar-nav-btn circle center-content"
                   id="calendar-prev-btn"
                   aria-label="Previous month (<%= calendar.prev.label %>)"
                   data-year="<%= calendar.prev.year %>"
                   data-month="<%= calendar.prev.month %>">
                    <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <path d="m15 18-6-6 6-6"></path>
                    </svg>
                </a>
                <a href="<%= nextHref %>"
                   class="calendar-nav-btn circle center-content"
                   id="calendar-next-btn"
                   aria-label="Next month (<%= calendar.next.label %>)"
                   data-year="<%= calendar.next.year %>"
                   data-month="<%= calendar.next.month %>">
                    <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <path d="m9 18 6-6-6-6"></path>
                    </svg>
                </a>
            </div>
        </div>
    </div>
    <div class="calendar-grid" id="calendar-grid" role="grid" aria-label="Monthly calendar days">
        <% calendar.weekdays.forEach(function (weekday) { %>
            <span class="calendar-weekday" role="columnheader"><%= weekday %></span>
        <% }) %>
        <% calendar.cells.forEach(function (cell) { %>
            <% if (!cell) { %>
                <span class="calendar-day calendar-day-empty" aria-hidden="true"></span>
            <% } else { %>
                <span class="calendar-day<%= cell.isToday ? ' calendar-day-today' : '' %><%= cell.hasDue ? ' calendar-day-due' : '' %>"
                      role="gridcell"
                      tabindex="0"
                      <% if (cell.isToday) { %>aria-current="date"<% } %>
                      aria-label="<%= cell.day %><%= cell.isToday ? ', today' : '' %><%= cell.hasDue ? ', has deadline' : '' %>"><%= cell.day %></span>
            <% } %>
        <% }) %>
    </div>
</section>
