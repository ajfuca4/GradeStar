<div class="input-group">
    <span class="subtle-text"> Course Code </span>
    <input id="course-code-input" type="text" placeholder="e.g. 'ABC123'">
</div>
<div class="input-group">
    <span class="subtle-text"> Course Title </span>
    <input type="text" placeholder="e.g. 'Introduction to Business">
</div>
<div id="popup-date-inputs">
    <div class="input-group">
        <span class="subtle-text"> Start Date </span>
        <input type="date">
    </div>
    <div class="input-group">
        <span class="subtle-text"> End Date </span>
        <input type="date">
    </div>
</div>
<button type="button" id="proceed-btn" class="emphasis-btn" data-proceed-course>
    Proceed
</button>
