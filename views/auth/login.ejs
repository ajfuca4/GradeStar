<div class="auth-card">
    <h2>Log in</h2>
    <form id="login" action="/login" method="post">
        <div class="form-group">
            <p id="email-err" class="err-text field-error"><%= emailErrMsg || '' %></p>
            <div class="input-bar">
                <i class="fa-solid fa-envelope" aria-hidden="true"></i>
                <input type="text" value="<%= emailVal || '' %>" class="<%= emailErrMsg ? 'inputErr' : '' %>" id="email-input" name="email" placeholder="Email address" required autocomplete="off">
            </div>
        </div>
        <div class="form-group">
            <p id="password-err" class="err-text field-error"><%= passwordErrMsg || '' %></p>
            <div class="input-bar">
                <i id="passwordHide" class="fa-solid fa-eye" role="button" tabindex="0" aria-label="Show password"></i>
                <input type="password" id="password" value="<%= passwordVal || '' %>" class="<%= passwordErrMsg ? 'inputErr' : '' %>" name="password" placeholder="Password" required autocomplete="off">
            </div>
        </div>
        <button type="submit" class="submit-btn">Log in</button>
        <p class="auth-footer">
            <span class="subtext">Don't have an account?</span>
            <a href="/signup">Sign up</a>
        </p>
    </form>
</div>
